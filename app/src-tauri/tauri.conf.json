{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ascent Flasher (unofficial)",
  "version": "0.1.0",
  "identifier": "io.github.ascentflasher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ascent Flasher (unofficial)",
        "width": 520,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
